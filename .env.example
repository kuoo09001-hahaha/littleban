# 本地开发配置模板。复制为 HDZB_agent/.env 后，填入你自己的密钥。
# 不要把真实 .env 提交到 Git。

# 大模型 API（当前默认是火山方舟的 OpenAI 兼容接口）
ARK_API_KEY=replace-with-your-ark-api-key
ARK_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
ARK_MODEL_NAME=deepseek-v3-250324
AMAP_API_KEY=replace-with-your-amap-api-key

# Agent 服务地址
SERVER_HOST=0.0.0.0
SERVER_PORT=8017
AGENT_MAX_TOKENS=800
AGENT_TEMPERATURE=0.7
AGENT_MAX_ITERATIONS=5

# 可选 ASR 语音网关；只测试文本 Agent 时不需要启动它。
ASR_SERVER_HOST=0.0.0.0
ASR_SERVER_PORT=8015
COMPANION_SERVICE_URL=http://localhost:8016
AGENT_SERVICE_URL=http://localhost:8017

# 本地数据目录
MEMORY_MAX_TOKENS=2000
MEMORY_WINDOW_SIZE=6
SQLITE_DB_PATH=./data/agent.db
VECTOR_STORE_PATH=./data/vector_store
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Local development
DEBUG=false
LOG_LEVEL=INFO
SAVE_FILE_DIR=./data/uploads
